# Copy to .env (it is git-ignored) and fill in from Payroll Audit > Settings > Local audit worker.
PHASEFORGE_URL=https://your-phaseforge-site.example
PAYROLL_AUDIT_COMPANY_ID=
PAYROLL_AUDIT_WORKER_KEY=
# Optional
# WORKER_NAME=Brad-Desktop
# WORKER_PROFILE_DIR=C:\Users\you\AppData\Local\PhaseForgeAuditWorker\chrome-profile
# WORKER_BROWSER=chrome   (chrome | msedge | chromium | full path to a Chromium based browser)
